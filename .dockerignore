ui/frontend/node_modules
ui/frontend/dist
__pycache__
*.pyc
.pytest_cache
.ruff_cache
*.egg-info

# Living docs are read on GitHub, not inside the container.
docs
CLAUDE.md
Dockerfile
.dockerignore
