# Copy to .env and fill in. .env is gitignored; never commit keys.

# --- Model API keys (one per provider you use) ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Model selection: "<provider>:<model_id>", any LangChain-supported provider ---
# Generator for the whole pipeline (default DeepSeek V4.1 Flash).
RFP_MODEL=deepseek:deepseek-flash
# Judge and gold-label drafter for evals (default Claude Sonnet 5.5).
RFP_JUDGE_MODEL=anthropic:claude-sonnet-5-5
# Sampling temperature for generator calls. Not sent to Anthropic models (current Claude
# models reject non-default sampling parameters).
RFP_TEMPERATURE=0
# Retries after a schema validation failure (the error is fed back to the model).
RFP_MAX_STRUCTURED_RETRIES=2
# Output-token cap per call; unset uses the provider default.
# RFP_MAX_OUTPUT_TOKENS=8000
# Per-request timeout in seconds, and SDK-level retries on 429/5xx/connection errors.
RFP_REQUEST_TIMEOUT_S=120
RFP_LLM_TRANSPORT_RETRIES=2
# DeepSeek thinking mode (the API default is on). Off here: structured output then uses
# forced tool calling. On: JSON mode with the schema in the prompt.
RFP_DEEPSEEK_THINKING=false
# Parallel LLM calls in per-chunk stages (problem-statement chunk summaries).
RFP_LLM_CONCURRENCY=4
# Ablation: build the problem statement from one full-text call instead of per-chunk
# summaries plus synthesis (S13 compares the two).
RFP_FULL_TEXT_PROBLEM=false
# Solution generator rounds: one generation, then a revision round while any mandatory
# requirement (submission items excluded) is addressed by no component. 1 = no revision.
RFP_SOLUTION_MAX_ITERATIONS=3

# --- Vision-model transcription of poorly rendered pages (ST2) ---
# Off by default. On: pages the parse-quality pass escalates (image-only tables, broken
# tables, garbled layout) are rendered to an image and transcribed by RFP_VLM_MODEL; the
# transcription replaces the library parser's markdown for that page. Needs the key of
# the VLM's provider (ANTHROPIC_API_KEY for the default).
RFP_VLM=false
RFP_VLM_MODEL=anthropic:claude-sonnet-5-5
# judged: only pages the LLM judge confirms bad (default). flagged: every heuristically
# flagged page, without a judge call (the ablation compares the two).
RFP_VLM_SCOPE=judged
# Page render resolution; 140 keeps a letter page under 1568 px on its long edge.
RFP_VLM_DPI=140

# --- Langfuse tracing (optional; tracing is a no-op when these are empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
